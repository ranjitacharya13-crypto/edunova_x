# EduNova_X frontend build config (Vite) — PUBLIC URLs only, NEVER secrets.
#
# Vite inlines every VITE_* variable into the JavaScript bundle at BUILD time.
# Anything here ships to the browser in plaintext, so put only public URLs here.
#
# HOW TO USE
#   Local development : copy this file to `frontend/.env` and leave the URLs
#                       empty — the Vite dev proxy (vite.config.mjs) forwards
#                       /api and /socket.io to the local backend on port 4000.
#   Production        : set these in the Cloudflare dashboard
#                       (Workers & Pages -> edunova-x -> Settings -> Variables),
#                       or export them in the shell that runs `npm run build`.
#                       They must be present AT BUILD TIME, not at runtime.

# Base URL of the Render Node/Express API, including the /api suffix.
# Example: https://edunova-api-y3rx.onrender.com/api
# Leave empty for local development (the dev proxy handles it).
VITE_API_URL=https://edunova-api-y3rx.onrender.com/api

# Socket.IO / WebRTC signaling origin — NO /api suffix, origin only.
# The Express API in server/ already hosts Socket.IO, so this is normally the
# SAME Render service as VITE_API_URL, just without the /api path.
# Example: https://edunova-signal.onrender.com
VITE_SIGNAL_URL=https://edunova-signal.onrender.com

# ---------------------------------------------------------------------------
# TURN server (REQUIRED for video calls on 4G/mobile / strict NAT networks)
# ---------------------------------------------------------------------------
# If VITE_TURN_URL is empty the app falls back to Google's public STUN server,
# which does NOT work reliably on mobile carrier NAT.
# VITE_TURN_URL=turn:your.turn.server.example:3478
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_CREDENTIAL=your_turn_credential
# Advanced: full ICE servers JSON (overrides the TURN vars above)
# VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
