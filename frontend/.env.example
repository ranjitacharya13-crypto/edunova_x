# Frontend build-time configuration. VITE_* values are public and embedded by Vite.
# Configure them in Cloudflare before building/deploying; never put secrets here.

# Production API URL must be public HTTPS and include /api.
VITE_API_URL=https://edunova-api-y3rx.onrender.com/api

# Socket.IO signaling origin — same Express service as the API, without /api.
VITE_SIGNAL_URL=https://edunova-api-y3rx.onrender.com

# Optional TURN service for WebRTC on restrictive/mobile networks.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_ICE_SERVERS_JSON=
