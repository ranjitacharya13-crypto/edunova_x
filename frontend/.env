# EduNova_X frontend build config (Vite) — PUBLIC URLs only, no secrets.
# This file is tracked because Cloudflare/Vercel builds bake these in at
# build time and the deployed site depends on them. To point the frontend at
# different backend URLs, update these (or set VITE_API_URL / VITE_SIGNAL_URL
# in the hosting dashboard, which takes precedence at build time).

VITE_API_URL=https://edunova-api.onrender.com/api
VITE_SIGNAL_URL=https://edunova-signal.onrender.com
VITE_API_PORT=4000
VITE_SIGNAL_PORT=5000

# ---------------------------------------------------------------------------
# TURN server (REQUIRED for video calls on 4G/mobile / strict NAT networks)
# ---------------------------------------------------------------------------
# Fill these in (or set them in scripts/deploy/.env.secrets) and the master
# script injects them into Vercel + the production build automatically.
# If VITE_TURN_URL is empty the app falls back to Google's public STUN server,
# which does NOT work reliably on mobile carrier NAT — so set these up.
# VITE_TURN_URL=turn:your.turn.server.example:3478
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_CREDENTIAL=your_turn_credential
# Advanced: full ICE servers JSON (overrides the TURN vars above)
# VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
