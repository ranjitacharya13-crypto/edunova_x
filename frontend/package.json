{
  "name": "edunova-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "electron:build": "npm run build && electron-builder --win dir --config.win.signAndEditExecutable=false",
    "cap:sync": "npm run build && npx cap sync"
  },
  "build": {
    "appId": "com.edunova.app",
    "productName": "EdunovaX",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.13.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "astral-regex": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.2",
    "postcss": "^8.4.0",
    "slice-ansi": "^9.0.0",
    "tailwindcss": "^3.0.0",
    "vite": "^5.0.0"
  }
}
