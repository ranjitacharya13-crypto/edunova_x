# EduNova X - Environment Variables

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/edunova_jwt

# JWT Secret for authentication
JWT_SECRET=your_super_secret_key_here

# Port for the server
PORT=4000

# AI Engine URL (FastAPI)
AI_ENGINE_URL=http://127.0.0.1:8001

# TURN Server Config (Optional - for WebRTC over 4G)
# VITE_TURN_URL=turn:your-turn-server.com
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=pass
