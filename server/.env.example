# EduNova X API — environment variable names only. Set production values in Render.

# MongoDB Atlas (MONGO_URI is canonical; MONGODB_URI is a supported compatibility alias).
MONGO_URI=
MONGODB_URI=

# JWT signing configuration.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Render injects PORT; local default is 4000.
PORT=
NODE_ENV=development

# Public HTTPS origin of the deployed FastAPI AI service (no route suffix).
AI_ENGINE_URL=
AI_ENGINE_TIMEOUT_MS=20000

# Comma-separated browser origins permitted by CORS.
CORS_ORIGIN=https://edunova-x.ranjitacharya13.workers.dev

# Optional contact delivery configuration.
EMAIL_USER=
EMAIL_PASS=
CONTACT_RECEIVER_EMAIL=

# Optional, explicit one-time admin bootstrap. All three are required together.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_TEMP_PASSWORD=
