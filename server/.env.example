# EduNova X - Server Environment Variables (local development)
# Never commit secrets. Set the same variables in Render → edunova-api → Environment.

# MongoDB Atlas connection string
MONGO_URI=

# JWT secret for authentication (long random string)
JWT_SECRET=

# Port for the server. Render injects PORT automatically; when it is unset,
# server.js uses port 4000 for local development.
PORT=
FRONTEND_URL=http://localhost:5173

# URL of the deployed FastAPI AI service (edunova-ai), WITHOUT a trailing
# slash. This is the gateway's AI peer; it OWNS the model in-process (a single
# supervised llama.cpp worker). render.yaml wires this automatically via
# `fromService` (edunova-ai -> RENDER_EXTERNAL_URL); leave empty to rely on
# that. Pointing this at a retired host returns a proxy/loading page and
# breaks /api/ai/health.
AI_ENGINE_URL=

# Shared secret for Express -> Python requests. Required in production when the
# AI service has AI_REQUIRE_INTERNAL_TOKEN=true; use the exact same value.
AI_INTERNAL_TOKEN=

# Network backstop and stream-idle watchdog. These never limit answer length.
AGENT_REQUEST_TIMEOUT=600000
# Reset by each SSE keep-alive or generated token; not an overall timer.
AGENT_STREAM_IDLE_TIMEOUT_MS=90000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20

# Cold-start resilience for the AI service. While a spun-down Render free-tier
# service wakes, its router answers with an HTML 503 page. The API retries
# those fast failures using this backoff schedule before reporting an error.
# Defaults: "3000,8000,15000,30000" within a 90000 ms total window.
AI_UPSTREAM_RETRY_DELAYS_MS=3000,8000,15000,30000
AI_UPSTREAM_RETRY_WINDOW_MS=90000

# Comma-separated list of allowed browser origins (frontend URL in production).
# When empty, only built-in production and local development origins are allowed.
CORS_ORIGIN=https://edunova-x.ranjitacharya13.workers.dev

# Optional: contact form (Gmail + App Password)
EMAIL_USER=
EMAIL_PASS=
CONTACT_RECEIVER_EMAIL=

# Optional: first-boot admin password (random and printed to logs if unset)
ADMIN_TEMP_PASSWORD=

# Reverse proxy hops (defaults to 2 on Render: Cloudflare -> Render Envoy LB -> Express)
TRUST_PROXY_HOPS=
# Optional shared secret authenticating X-EduNova-Client-IP from Cloudflare Worker proxy
PROXY_SECRET=

# Login brute-force rate limiter (sliding window, backed by MongoDB with memory fallback)
LOGIN_WINDOW_MS=300000
LOGIN_MAX_FAILURES_PER_ACCOUNT=10
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_MAX_FAILURES_PER_ACCOUNT_GLOBAL=40

# Demo accounts:
# - SEED_DEMO_STUDENT defaults to true (idempotently ensures student@edunova.demo)
# - SEED_DEMO_USERS is opt-in ("true") for non-production teacher/student dev fixtures only
SEED_DEMO_STUDENT=true
SEED_DEMO_USERS=false
