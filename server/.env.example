# EduNova X - Server Environment Variables (local development)
# Never commit secrets. Set the same variables in Render → edunova-api → Environment.

# MongoDB Atlas connection string
MONGO_URI=

# JWT secret for authentication (long random string)
JWT_SECRET=

# Port for the server (Render injects PORT automatically). BACKEND_PORT is the
# local-development alias used by the agent setup guide.
PORT=
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5173

# URL of the deployed Python agent engine, e.g. https://edunova-ai-o2vy.onrender.com
AI_ENGINE_URL=https://edunova-ai-o2vy.onrender.com

# Shared secret for Express -> Python requests. Required in production when the
# AI service has AI_REQUIRE_INTERNAL_TOKEN=true; use the exact same value.
AI_INTERNAL_TOKEN=

# Agent proxy timeout and authenticated per-user rate limit.
AGENT_REQUEST_TIMEOUT=210000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20

# Comma-separated list of allowed browser origins (frontend URL in production).
# When empty, only built-in production and local development origins are allowed.
CORS_ORIGIN=https://edunova-x.ranjitacharya13.workers.dev

# Optional: contact form (Gmail + App Password)
EMAIL_USER=
EMAIL_PASS=
CONTACT_RECEIVER_EMAIL=

# Optional: first-boot admin password (random and printed to logs if unset)
ADMIN_TEMP_PASSWORD=

# Optional: set "false" to disable demo teacher/student seeding
SEED_DEMO_USERS=
