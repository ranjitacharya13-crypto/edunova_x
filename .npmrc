# ---------------------------------------------------------------------------
# Skip downloading the Electron prebuilt binary during `npm install`.
#
# The root package.json needs the `electron` PACKAGE only for the desktop
# launcher; electron-builder downloads its own Electron distribution at
# packaging time (see `npm run desktop:build`).
#
# Without this, electron's postinstall (node install.js) tries to fetch a
# ~100MB binary from github.com and FAILS THE ENTIRE `npm install` on CI /
# Render / Cloudflare, where such downloads are blocked or TLS-intercepted:
#
#   npm error path .../node_modules/electron
#   npm error command sh -c node install.js
#   npm error RequestError: unable to verify the first certificate
#
# npm exposes every .npmrc key to lifecycle scripts as npm_config_<key>, and
# electron's install.js reads `process.env.npm_config_electron_skip_binary_download`
# in addition to ELECTRON_SKIP_BINARY_DOWNLOAD — hence the key below.
#
# Belt and braces: electron lives in devDependencies, so the documented
# production install (`npm install --omit=dev`) never touches it at all.
# ---------------------------------------------------------------------------
electron_skip_binary_download=true

# Keep deployment logs clean and never let audit/fund noise affect exit codes.
fund=false
audit=false
