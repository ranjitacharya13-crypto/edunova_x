# EduNova AI Agent — server-side configuration only. Never expose these values
# through VITE_* variables or commit a real .env file.

# OpenAI-compatible model endpoint. OpenAI is the default; compatible gateways
# may be selected by changing LLM_BASE_URL and LLM_MODEL.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_REQUEST_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TEMPERATURE=0.2
LLM_JSON_MODE=true

# Supported providers: brave, tavily, serper
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_MAX_RESULTS=5

# Autonomous-loop safety and cost limits
MAX_AGENT_ITERATIONS=12
MAX_TOOL_CALLS=15
MAX_AGENT_RUNTIME_SECONDS=180
AGENT_MAX_CONTEXT_CHARS=90000
CONVERSATION_MAX_TURNS=12
CONVERSATION_TTL_SECONDS=86400

# Secure webpage retrieval limits
WEB_REQUEST_TIMEOUT=10
WEB_MAX_CONTENT_LENGTH=200000
WEB_MAX_EXTRACTED_CHARS=45000
WEB_MAX_REDIRECTS=5

# Optional shared secret between Express and this service. If set here, set the
# exact same value as AI_INTERNAL_TOKEN on the Express API service.
AI_INTERNAL_TOKEN=
APP_BACKEND_URL=http://127.0.0.1:4000
# Set true in production after configuring the shared token on both services.
AI_REQUIRE_INTERNAL_TOKEN=false

# Browser origins are mostly relevant for local direct testing; production
# browsers call the authenticated Express API instead of this internal service.
CORS_ORIGIN=http://localhost:5173
PORT=8001
