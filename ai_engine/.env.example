# EduNova AI Agent — server-side configuration only. Never expose these values
# through VITE_* variables or commit a real .env file.

# -----------------------------------------------------------------------------
# SELF-HOSTED LOCAL MODEL (default; no external LLM API, no API key)
# -----------------------------------------------------------------------------
# A quantized GGUF model runs in-process via llama.cpp and is the actual AI
# brain. It is downloaded on first boot from HuggingFace (or LOCAL_MODEL_URL)
# into LOCAL_MODEL_DIR (ephemeral on Render free — re-downloads on cold start).
#
# Default model is sized for Render free tier (512MB RAM / shared CPU).
# Bigger plans can run a bigger model — see DEPLOYMENT.md "Self-hosted model".
LLM_PROVIDER=local
LOCAL_MODEL_REPO=bartowski/Qwen2.5-0.5B-Instruct-GGUF
LOCAL_MODEL_FILE=Qwen2.5-0.5B-Instruct-IQ3_XXS.gguf
# Optional: direct download URL + integrity pin
# LOCAL_MODEL_URL=
# LOCAL_MODEL_SHA256=
LOCAL_MODEL_DIR=./models_cache
LOCAL_MODEL_CTX=3072
LOCAL_MODEL_THREADS=2
LOCAL_MODEL_BATCH=256
LOCAL_MODEL_CHAT_FORMAT=chatml
LOCAL_PRELOAD_MODEL=true
LOCAL_CHAT_WAIT_TIMEOUT=25
LOCAL_MODEL_DOWNLOAD_TIMEOUT=900

# Generation character of the local model
LLM_MAX_OUTPUT_TOKENS=900
LLM_TEMPERATURE=0.2

# -----------------------------------------------------------------------------
# LEGACY / ROLLBACK ONLY — external OpenAI-compatible provider.
# NOT used while LLM_PROVIDER=local. To roll back temporarily:
#   LLM_PROVIDER=openai_compatible + LLM_API_KEY + LLM_MODEL + LLM_BASE_URL
# Remove these in production once the local model is verified.
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_REQUEST_TIMEOUT=60
# LLM_JSON_MODE=true

# Supported providers: brave, tavily, serper (kept: web search feeds the model)
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_MAX_RESULTS=5

# Autonomous-loop safety and cost limits (local defaults are already tightened)
MAX_AGENT_ITERATIONS=5
MAX_TOOL_CALLS=8
MAX_AGENT_RUNTIME_SECONDS=180
AGENT_MAX_CONTEXT_CHARS=24000
CONVERSATION_MAX_TURNS=12
CONVERSATION_TTL_SECONDS=86400

# Secure webpage retrieval limits
WEB_REQUEST_TIMEOUT=10
WEB_MAX_CONTENT_LENGTH=200000
WEB_MAX_EXTRACTED_CHARS=45000
WEB_MAX_REDIRECTS=5

# Optional shared secret between Express and this service. If set here, set the
# exact same value as AI_INTERNAL_TOKEN on the Express API service.
AI_INTERNAL_TOKEN=
APP_BACKEND_URL=http://127.0.0.1:4000
# Set true in production after configuring the shared token on both services.
AI_REQUIRE_INTERNAL_TOKEN=false

# Browser origins are mostly relevant for local direct testing; production
# browsers call the authenticated Express API instead of this internal service.
CORS_ORIGIN=http://localhost:5173
PORT=8001
