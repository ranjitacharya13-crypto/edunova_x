# EduNova AI — server-side configuration only. Never expose these values
# through VITE_* variables or commit a real .env file.
#
# =============================================================================
# ONE SERVICE OWNS THE MODEL. AI_INFERENCE_URL IS OPTIONAL (LEGACY SPLIT).
# =============================================================================
#   edunova-ai  ->  `main:app`  (orchestrator + OWNED in-process model)
#
# The orchestrator loads the GGUF itself through a single supervised llama.cpp
# worker (inference/inprocess.py) — llama-cpp-python is an internal library,
# not an external service. AI_INFERENCE_URL is only needed for the legacy split
# topology (a standalone `inference_server:app` process). If a stale
# AI_INFERENCE_URL is present but the split service is broken (AUTH_FAILED /
# unreachable), the orchestrator heals to the owned in-process model at startup
# and reports splitTopologyHealed=true on /health.
#
#   edunova-ai  needs: AI_INTERNAL_TOKEN + the LOCAL_MODEL_* block below
#
# -----------------------------------------------------------------------------
# OPTIONAL LEGACY SPLIT (leave unset for the owned in-process model)
# -----------------------------------------------------------------------------
# Public HTTPS URL of a standalone inference service, no trailing slash.
# Local dev split: http://127.0.0.1:8002. Do NOT set this on the production
# edunova-ai service — the model is owned in-process there.
# AI_INFERENCE_URL=http://127.0.0.1:8002
# Per-request network ceiling for ONE inference call. A safety net only:
# generation is never truncated by it.
# AI_INFERENCE_REQUEST_TIMEOUT=600

# -----------------------------------------------------------------------------
# OWNED MODEL (runs in the edunova-ai process via llama.cpp)
# -----------------------------------------------------------------------------
# A quantized GGUF model is the actual AI brain. It is downloaded ONCE from
# HuggingFace (or LOCAL_MODEL_URL) into LOCAL_MODEL_DIR and re-used from there
# on every later start. Point LOCAL_MODEL_DIR at a persistent disk (paid plans
# only) so a redeploy does not re-download ~100MB; on Render Free the dir is
# instance-local.
#
# The default repo/file below is VERIFIED to exist and is integrity-pinned
# (size + sha256) in ai_engine/config.py -> KNOWN_MODELS. If you change
# LOCAL_MODEL_FILE, copy the exact filename from
# https://huggingface.co/<LOCAL_MODEL_REPO>/tree/main — a filename that does not
# exist there fails the startup preflight with a MODEL_STARTUP_ERROR / HTTP 404.
#
# RAM: RENDER FREE (512 MiB) IS THE TARGET. SmolLM2-135M-Instruct Q4_1
# (~98 MiB weights, ~460 MiB total with KV@2048 + runtime + margin) fits it.
# Qwen2.5-0.5B needs 700+ MiB and fails a 512 MiB host with
# MODEL_RESOURCE_INSUFFICIENT — that was the incident; do not set it as the
# default below unless the instance is >= 1 GB (then also raise ctx/threads).
# Custom EduNova HRM (PyTorch). Default remains llama_cpp on Render Free.
# LOCAL_MODEL_RUNTIME=hrm
# HRM_SIZE=20m
# HRM_CONFIG_PATH=configs/model/20m.yaml
# HRM_CHECKPOINT=./models_cache/hrm
# HRM_ALLOW_UNTRAINED=false
# MAX_TOOL_STEPS=8
LLM_PROVIDER=local
LOCAL_MODEL_REPO=QuantFactory/SmolLM2-135M-Instruct-GGUF
LOCAL_MODEL_FILE=SmolLM2-135M-Instruct.Q4_1.gguf
LOCAL_MODEL_DIR=./models_cache
# Max quality the 512MB free plan still holds (~138 MiB weights):
# LOCAL_MODEL_FILE=SmolLM2-135M-Instruct-Q8_0.gguf
# 1 GB+ instance, better reasoning on the same chat format:
# LOCAL_MODEL_REPO=bartowski/SmolLM2-360M-Instruct-GGUF
# LOCAL_MODEL_FILE=SmolLM2-360M-Instruct-Q4_K_M.gguf
# 2 GB+ instance (NOT free): previous production default, strongest small model.
# LOCAL_MODEL_REPO=bartowski/Qwen2.5-0.5B-Instruct-GGUF
# LOCAL_MODEL_FILE=Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
# LOCAL_MODEL_CTX=6144
# LOCAL_MODEL_THREADS=2
#
# Optional: direct download URL + integrity pin. Only needed for a model that
# is not in the verified catalogue (a private mirror, a pre-signed link, ...).
# Never commit a URL that embeds credentials.
# LOCAL_MODEL_URL=
# LOCAL_MODEL_SHA256=
# LOCAL_MODEL_BYTES=
LOCAL_MODEL_CTX=2048
LOCAL_MODEL_THREADS=1
LOCAL_MODEL_BATCH=256
LOCAL_MODEL_CHAT_FORMAT=chatml
LOCAL_PRELOAD_MODEL=true
LOCAL_CHAT_WAIT_TIMEOUT=25
LOCAL_MODEL_DOWNLOAD_TIMEOUT=900
LOCAL_MODEL_DOWNLOAD_RETRIES=3

# Quality ceiling; routing adaptively uses 128–1024 tokens by task. This is
# never reduced based on elapsed wall-clock time. Keep <= ~half of
# LOCAL_MODEL_CTX so prompt + answer physically fit the 2048-token window.
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2

# -----------------------------------------------------------------------------
# RAG SEMANTIC EMBEDDINGS — OFF on the 512 MiB inference runtime
# -----------------------------------------------------------------------------
# RAG_ENABLED controls whether the INFERENCE service loads the PyTorch
# sentence-embedding model for POST /embeddings (MiniLM ≈ 260 MiB RSS). The
# 512 MiB free instance cannot hold it, so it stays false there; the RAG
# architecture (inference/rag.py, orchestrator index, retrieval tool) remains
# in the codebase untouched. To enable on a >= 1-2 GB inference instance:
# set RAG_ENABLED=true here AND on edunova-ai, which switches the orchestrator
# retrieval from "disabled" to real semantic search over EduNova materials.
RAG_ENABLED=false
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_PERSIST_DIR=        # empty => <LOCAL_MODEL_DIR>/rag

# -----------------------------------------------------------------------------
# LEGACY / ROLLBACK ONLY — external OpenAI-compatible provider.
# NOT used while LLM_PROVIDER=local. To roll back temporarily:
#   LLM_PROVIDER=openai_compatible + LLM_API_KEY + LLM_MODEL + LLM_BASE_URL
# Remove these in production once the local model is verified.
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_REQUEST_TIMEOUT=60
# LLM_JSON_MODE=true

# Supported providers: brave, tavily, serper (kept: web search feeds the model)
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_MAX_RESULTS=5

# Autonomous-loop safety and cost limits (local defaults are already tightened)
# AGENT_MAX_CONTEXT_CHARS must fit inside LOCAL_MODEL_CTX (~3 chars/token)
# alongside the system prompt and the answer budget — 6000 is the honest cap
# at ctx 2048; larger values only make sense with a larger LOCAL_MODEL_CTX.
MAX_AGENT_ITERATIONS=3
MAX_TOOL_CALLS=8
MAX_AGENT_RUNTIME_SECONDS=180
AGENT_MAX_CONTEXT_CHARS=6000
CONVERSATION_MAX_TURNS=12
CONVERSATION_TTL_SECONDS=86400

# Secure webpage retrieval limits
WEB_REQUEST_TIMEOUT=10
WEB_MAX_CONTENT_LENGTH=200000
WEB_MAX_EXTRACTED_CHARS=45000
WEB_MAX_REDIRECTS=5

# Shared internal secret. ONE random value, set identically on BOTH services:
# edunova-api and edunova-ai. It authenticates service-to-service calls only
# and must never reach the browser (it is not a VITE_* variable and is not
# bundled into the frontend).
AI_INTERNAL_TOKEN=
APP_BACKEND_URL=http://127.0.0.1:4000
# Set true in production once the same token is configured on both services.
# When true, an empty AI_INTERNAL_TOKEN aborts startup instead of serving
# 503 AUTH_FAILED to the first request.
AI_REQUIRE_INTERNAL_TOKEN=false

# Browser origins are mostly relevant for local direct testing; production
# browsers call the authenticated Express API instead of this internal service.
CORS_ORIGIN=http://localhost:5173
PORT=8001
