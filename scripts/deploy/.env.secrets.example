# =============================================================================
# EduNova_X deploy secrets — copy to scripts/deploy/.env.secrets and fill in.
# This file is gitignored (matches `.env.*`) — NEVER commit real secrets.
# =============================================================================

# --- Tokens ---------------------------------------------------------------
VERCEL_TOKEN=                                  # Vercel access token
RENDER_API_KEY=                                # Render API key (rnd_...)

# --- Repo / branch (services are created from this repo+branch) -----------
GIT_REPO=https://github.com/ranjitacharya13-crypto/edunova_x
GIT_BRANCH=main

# --- Render workspace (optional; auto-detected from the API key) ----------
# RENDER_OWNER_ID=

# --- Backend secrets (values copied from server/.env) ----------------------
# Note: double-quote any value containing spaces or special characters.
MONGO_URI=                                     # MongoDB Atlas connection string
JWT_SECRET=                                    # long random string
ADMIN_TEMP_PASSWORD=                           # optional, first-boot admin pw
EMAIL_USER=                                    # Gmail address for contact form
EMAIL_PASS=                                    # Gmail App Password (16 chars)
CONTACT_RECEIVER_EMAIL=                        # where contact messages go
SEED_DEMO_USERS=true

# --- TURN server (video on 4G/mobile / strict NAT) --------------------------
# Fill these with your TURN provider credentials (e.g. Metered.ca, Twilio,
# Xirsys, or a self-hosted coturn). They are injected into Vercel env vars,
# frontend/vercel.json and .env.production. Leave empty to use STUN only.
VITE_TURN_URL=turn:your.turn.server.example:3478
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_credential
# Optional: full ICE servers JSON (overrides the TURN vars above)
# VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# --- Vercel project (optional; defaults to edunova-x) -----------------------
# VERCEL_PROJECT=edunova-x
