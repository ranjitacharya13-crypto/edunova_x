# Dependencies — MUST NOT be committed (platform-specific binaries break builds)
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
frontend/dist/
out/

# Env & secrets (never commit these)
.env
.env.*
.env *
**/.env *
!.env.example
!**/.env.secrets.example
.env.secrets
**/.env.secrets
frontend/.env.production

# Vercel & Cloudflare
.vercel/
**/.vercel/
.wrangler/
**/.wrangler/
.cloudflare/


# Python
__pycache__/
*.pyc
.venv/

# Logs & OS / editors
*.log
.DS_Store
Thumbs.db
.vscode/

# Backup files (created by text editors with auto-save or version conflicts)
* 1.*
* 2.*
* 3.*

# Release / installer snapshots (built from source, distributed via GitHub
# Releases — never commit them into the source tree). A committed copy once
# embedded real MongoDB credentials in a stale bundled .env, so this stays out.
edunova-x-installer.zip
