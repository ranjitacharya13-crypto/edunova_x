# Dependencies — MUST NOT be committed (platform-specific binaries break builds)
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
frontend/dist/
out/

# Env & secrets (never commit these)
.env
.env.*
!.env.example
!**/.env.secrets.example
.env.secrets
**/.env.secrets
frontend/.env.production

# Vercel
.vercel/
**/.vercel/

# Python
__pycache__/
*.pyc
.venv/

# Logs & OS / editors
*.log
.DS_Store
Thumbs.db
.vscode/
