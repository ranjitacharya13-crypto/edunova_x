# =============================================================================
# EduNova X — Environment Variables (NAMES ONLY — never commit real values)
# -----------------------------------------------------------------------------
# Copy to `.env` for local development, or set these in the hosting dashboard
# for production:
#   Backend + AI  -> Render  (Dashboard -> service -> Environment)
#   Frontend      -> Cloudflare (Workers & Pages -> edunova-x -> Variables)
# =============================================================================

# -----------------------------------------------------------------------------
# NODE API  (Render service: edunova-api, rootDir: server)
# -----------------------------------------------------------------------------

# MongoDB Atlas connection string. REQUIRED.
# Format: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Atlas -> Network Access must allow 0.0.0.0/0 (Render egress IPs are dynamic).
MONGO_URI=

# Secret used to sign JWTs. REQUIRED — auth fails without it.
# Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Port to listen on. Render injects this automatically; leave empty locally
# to use the default (4000). Never hardcode this in production.
PORT=
FRONTEND_URL=http://localhost:5173

# Public HTTPS URL of the deployed FastAPI AI service (edunova-ai, which OWNS
# the model in-process), WITHOUT a trailing slash. This is the gateway's only
# AI peer. render.yaml wires this automatically (fromService: edunova-ai ->
# RENDER_EXTERNAL_URL), so it is normally left empty here. A stale value
# pointing at a retired host makes /api/ai/health return a proxy error page
# (-> 502/503). If unset in production, /api/ai/* returns 503 CONFIG_FAILED
# instead of hanging.
AI_ENGINE_URL=

# Comma-separated list of browser origins allowed by CORS.
# The Cloudflare Workers frontend is always allowed even if this is unset.
CORS_ORIGIN=https://edunova-x.ranjitacharya13.workers.dev

# Optional: contact form email (Gmail address + 16-char App Password).
EMAIL_USER=
EMAIL_PASS=
CONTACT_RECEIVER_EMAIL=

# Optional: first-boot admin password. If unset, an admin account is NOT
# created (the password is never hardcoded in the repository).
ADMIN_TEMP_PASSWORD=

# Demo STUDENT advertised on the login card ("Login as Demo Student"):
#   student@edunova.demo / Student@12345
# It is provisioned idempotently on every server start (server/services/
# demoAccount.js) because the button authenticates against this REAL record
# through POST /api/auth/login. Set to "false" to opt out entirely.
SEED_DEMO_STUDENT=true
# Optional: override the seeded demo password. Must match the password printed
# on the login page, otherwise the demo login returns 401.
# DEMO_STUDENT_PASSWORD=

# Optional: set "true" to also seed the legacy throwaway accounts
# teacher@edunova.com / student@edunova.com (password "123456"). IGNORED in
# production (NODE_ENV=production) — those credentials are weak on purpose.
SEED_DEMO_USERS=

# -----------------------------------------------------------------------------
# PYTHON AI LAYER — ONE service, rootDir: ai_engine
#   edunova-ai = ORCHESTRATOR + OWNED MODEL (main:app), ~270-320 MiB
# -----------------------------------------------------------------------------
# Render FREE sizing: edunova-ai runs SmolLM2-135M-Instruct Q4_1 (llama.cpp,
# ctx 2048, 1 thread, RAG/embeddings off) inside the 512 MiB free plan — the
# GGUF is owned in-process through a single supervised llama.cpp worker.
# Never upgrade the plan and never add an external LLM API key to make things
# "work" — swap to a catalogue model that fits instead.
# The agent does not need MongoDB; user authentication remains in Express.

# LEGACY SPLIT ONLY (leave unset). Setting this selects the standalone
# inference_server.py topology. A stale value pointing at a broken service is
# healed to the owned in-process model at startup.
# AI_INFERENCE_URL=http://127.0.0.1:8002
# AI_INFERENCE_REQUEST_TIMEOUT=600

# SELF-HOSTED MODEL (runs inside edunova-ai). A quantized GGUF model runs via
# llama.cpp and is the AI brain — no OpenAI/Groq/Gemini/Anthropic keys.
# Verified + integrity-pinned in ai_engine/config.py -> KNOWN_MODELS. Fits
# RENDER FREE (512 MiB) at ctx 2048 with RAG disabled (~460 MiB required per
# inference/resources.py, checked at boot). Qwen2.5-0.5B-class models
# (~740+ MiB) need a >= 1-2 GB instance and fail the 512 MiB resource check
# by design.
LLM_PROVIDER=local
LOCAL_MODEL_REPO=QuantFactory/SmolLM2-135M-Instruct-GGUF
LOCAL_MODEL_FILE=SmolLM2-135M-Instruct.Q4_1.gguf
# Cache dir for the weights — Render Free has no persistent disk, so the
# ~100MB download happens on cold boot (a mounted disk on paid plans makes it
# once-per-deploy).
LOCAL_MODEL_DIR=./models_cache
# LOCAL_MODEL_URL=        # optional direct download URL / mirror
# LOCAL_MODEL_SHA256=     # integrity pin (auto for catalogue models)
# LOCAL_MODEL_BYTES=      # exact size pin (auto for catalogue models)
LOCAL_MODEL_CTX=2048
LOCAL_MODEL_THREADS=1
LOCAL_MODEL_CHAT_FORMAT=chatml
LOCAL_CHAT_WAIT_TIMEOUT=25
LOCAL_MODEL_DOWNLOAD_TIMEOUT=900
LOCAL_MODEL_DOWNLOAD_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
# RAG semantic embeddings: OFF on the 512 MiB runtime so PyTorch is never
# loaded there (architecture stays; enable on >= 1-2 GB instances).
RAG_ENABLED=false

# LEGACY / ROLLBACK ONLY (not used while LLM_PROVIDER=local). Remove after the
# local model is verified in production. Keep all credentials on the AI
# service only; HTTPS is enforced for public endpoints.
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_REQUEST_TIMEOUT=60
# LLM_JSON_MODE=true

# Web search provider (kept — the model reasons over live search results).
# Supported: brave, tavily, serper.
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_MAX_RESULTS=5

# Autonomous-loop, context, request, and conversation limits.
# AGENT_MAX_CONTEXT_CHARS must fit inside LOCAL_MODEL_CTX (~3 chars/token)
# with the answer budget: 6000 is the honest cap at ctx 2048.
MAX_AGENT_ITERATIONS=3
MAX_TOOL_CALLS=8
MAX_AGENT_RUNTIME_SECONDS=180
AGENT_MAX_CONTEXT_CHARS=6000
WEB_REQUEST_TIMEOUT=10
WEB_MAX_CONTENT_LENGTH=200000
WEB_MAX_EXTRACTED_CHARS=45000
WEB_MAX_REDIRECTS=5
CONVERSATION_MAX_TURNS=12
CONVERSATION_TTL_SECONDS=86400

# Shared internal secret. ONE random value, set identically on BOTH Render
# services: edunova-api and edunova-ai. It authenticates service-to-service
# calls only — never expose it as a VITE_* variable. With
# AI_REQUIRE_INTERNAL_TOKEN=true an empty value aborts edunova-ai startup
# instead of 503-ing the first request.
AI_INTERNAL_TOKEN=
AI_REQUIRE_INTERNAL_TOKEN=false
AGENT_REQUEST_TIMEOUT=210000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20

# -----------------------------------------------------------------------------
# FRONTEND  (Cloudflare Workers — BUILD-TIME variables)
# -----------------------------------------------------------------------------
# Vite inlines VITE_* values into the bundle at BUILD time, so these must be
# set before `npm run build` runs. They are PUBLIC — never put secrets here.
# See frontend/.env.example for details.

# Render API base URL INCLUDING the /api suffix.
# Example: https://edunova-api-y3rx.onrender.com/api
VITE_API_URL=https://edunova-api-y3rx.onrender.com/api

# Socket.IO / WebRTC signaling ORIGIN (no /api suffix).
# Normally the SAME Render API service, since it hosts Socket.IO. Leave empty
# to derive it from VITE_API_URL automatically; set it only if signaling runs
# as a separate service.
VITE_SIGNAL_URL=
