# EduNova X - Environment Variables
# Copy to .env (or set in Render) and fill in real values. Never commit secrets.

# MongoDB Atlas connection string
MONGO_URI=

# JWT secret for authentication (long random string)
JWT_SECRET=

# Port for the server (Render injects PORT automatically)
PORT=

# URL of the deployed Python AI engine, e.g. https://edunova-ai.onrender.com
AI_ENGINE_URL=

# Comma-separated list of allowed browser origins, e.g. https://edunova-frontend.onrender.com
# (leave empty to allow any origin — local development only)
CORS_ORIGIN=

# Frontend build-time variables (set on the Static Site service in Render)
VITE_API_URL=
VITE_SIGNAL_URL=

# Optional: contact form (Gmail + App Password)
EMAIL_USER=
EMAIL_PASS=
CONTACT_RECEIVER_EMAIL=

# Optional: first-boot admin password (random and printed to logs if unset)
ADMIN_TEMP_PASSWORD=

# Optional: set "false" to disable demo teacher/student seeding
SEED_DEMO_USERS=

# Optional: AI engine timetable document IDs
STUDENT_TIMETABLE_ID=
TEACHER_TIMETABLE_ID=
